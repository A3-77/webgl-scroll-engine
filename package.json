    "react-dom": "^18.3.1",
    "three": "^0.181.2",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.181.0",
